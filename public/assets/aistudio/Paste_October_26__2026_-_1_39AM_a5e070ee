    * {
      box-sizing: border-box;
    }

    body {
      font-family: 'Play', sans-serif;
      margin: 0;
      width: 100vw;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      transition: background 0.5s ease;
      overflow: hidden;
      padding: 25px;
    }

    /* Ambient dynamic backgrounds for Glassmorphism */
    body.theme-dark {
      background: linear-gradient(135deg, #0f0c1f 0%, #1e1738 50%, #2b1f48 100%);
    }

    body.theme-light {
      background: linear-gradient(135deg, #dce7fe 0%, #ebdffd 45%, #fbe8ec 100%);
    }

    /* Floating glowing orbs in background to amplify glass refraction */
    .ambient-glow-1 {
      position: fixed;
      width: 480px;
      height: 480px;
      border-radius: 50%;
      filter: blur(120px);
      z-index: 0;
      pointer-events: none;
      transition: background 0.5s ease;
    }

    .ambient-glow-2 {
      position: fixed;
      width: 420px;
      height: 420px;
      border-radius: 50%;
      filter: blur(130px);
      z-index: 0;
      pointer-events: none;
      transition: background 0.5s ease;
    }

    .theme-dark .ambient-glow-1 {
      top: 5%;
      left: 10%;
      background: rgba(124, 58, 237, 0.28);
    }
    .theme-dark .ambient-glow-2 {
      bottom: 5%;
      right: 12%;
      background: rgba(236, 72, 153, 0.22);
    }

    .theme-light .ambient-glow-1 {
      top: 5%;
      left: 8%;
      background: rgba(147, 197, 253, 0.5);
    }
    .theme-light .ambient-glow-2 {
      bottom: 8%;
      right: 10%;
      background: rgba(244, 114, 182, 0.35);
    }

    /* Thuộc tính thẻ Kính mờ siêu thực (Glassmorphism Card Properties) */
    .glass-card {
      position: relative;
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      overflow: hidden;
    }

    .theme-dark .glass-card {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.45), inset 0 1px 1px 0 rgba(255, 255, 255, 0.18);
    }

    .theme-dark .glass-card:hover {
      background: rgba(255, 255, 255, 0.09);
      border-color: rgba(167, 139, 250, 0.45);
      box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.65), 0 0 25px rgba(139, 92, 246, 0.22), inset 0 1px 2px 0 rgba(255, 255, 255, 0.35);
      transform: translateY(-4px);
    }

    .theme-light .glass-card {
      background: rgba(255, 255, 255, 0.65);
      border: 1px solid rgba(255, 255, 255, 0.9);
      box-shadow: 0 10px 25px -5px rgba(100, 80, 160, 0.12), inset 0 1px 2px 0 rgba(255, 255, 255, 0.95);
    }

    .theme-light .glass-card:hover {
      background: rgba(255, 255, 255, 0.85);
      border-color: rgba(167, 139, 250, 0.55);
      box-shadow: 0 20px 35px -8px rgba(100, 80, 160, 0.2), 0 0 22px rgba(168, 85, 247, 0.18), inset 0 1px 3px 0 #ffffff;
      transform: translateY(-4px);
    }

    /* Hiệu ứng vệt sáng phản chiếu ánh kính khi di chuột (Specular Light Sheen) */
    .glass-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: -120%;
      width: 70%;
      height: 100%;
      background: linear-gradient(
        90deg,
        transparent,
        rgba(255, 255, 255, 0.15),
        transparent
      );
      transform: skewX(-25deg);
      transition: left 0.75s ease;
      pointer-events: none;
      z-index: 10;
    }
    .glass-card:hover::before {
      left: 140%;
    }

    /* Huy hiệu chỉ số kính mờ (Frosted Glass Badge) */
    .glass-badge {
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.22);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.25);
    }

