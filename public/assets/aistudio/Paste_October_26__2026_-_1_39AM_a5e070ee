    // Main App
    function App() {
      // Nhận diện và thiết lập mặc định theo giao diện hệ thống (System Theme)
      const getSystemTheme = () => {
        if (typeof window !== 'undefined' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      };

      const [theme, setTheme] = useState(getSystemTheme); // 'dark' | 'light'
      const [isManual, setIsManual] = useState(false);
      const [activeNav, setActiveNav] = useState(0);

      // Tự động đồng bộ khi hệ điều hành thay đổi giữa Dark / Light (nếu người dùng chưa chọn thủ công)
      useEffect(() => {
        if (typeof window === 'undefined' || !window.matchMedia) return;
        const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
        const handleSystemThemeChange = (e) => {
          if (!isManual) {
            setTheme(e.matches ? 'dark' : 'light');
          }
        };

        if (mediaQuery.addEventListener) {
          mediaQuery.addEventListener('change', handleSystemThemeChange);
          return () => mediaQuery.removeEventListener('change', handleSystemThemeChange);
        } else if (mediaQuery.addListener) {
          mediaQuery.addListener(handleSystemThemeChange);
          return () => mediaQuery.removeListener(handleSystemThemeChange);
        }
      }, [isManual]);

      // Giữ class body đồng bộ cho hiệu ứng chuyển màu nền
      useEffect(() => {
        document.body.className = theme === 'dark' ? 'theme-dark' : 'theme-light';
      }, [theme]);

      const toggleTheme = () => {
        setIsManual(true);
        setTheme((prev) => (prev === 'dark' ? 'light' : 'dark'));
      };

      // Theme design tokens
      const isDark = theme === 'dark';

      return (
        <div
          className={clsx(
            'w-full h-full rounded-[30px] flex overflow-hidden transition-all duration-300 relative',
            // Glassmorphic Outer Chassis
            isDark
              ? 'bg-[#1e1737]/75 backdrop-blur-2xl border border-white/10 shadow-[0_25px_60px_-15px_rgba(0,0,0,0.7)] text-slate-100'
              : 'bg-white/70 backdrop-blur-2xl border border-white/80 shadow-[0_25px_60px_-15px_rgba(80,60,140,0.18)] text-slate-800'
          )}
        >
          {/* Sidebar Menu Trái */}
          <SidebarLeft
            active={activeNav}
            setActive={setActiveNav}
            isDark={isDark}
          />

          {/* Vùng Nội Dung Chính */}
          <div className="flex-1 flex flex-col h-full pl-6 pr-4 overflow-hidden">
            <Header
              theme={theme}
              toggleTheme={toggleTheme}
              isDark={isDark}
            />

            <div className="flex-1 overflow-y-auto pr-3 pb-6 space-y-6">
              {/* Hàng trên: Hero Tiện ích nổi bật & Quy trình Step-by-Step */}
              <div className="flex items-start justify-between gap-6">
                <HeroToolSection isDark={isDark} />
                <NewsSection isDark={isDark} />
              </div>

              {/* Hàng dưới: Kho Tiện Ích */}
              <TopSelection isDark={isDark} />
            </div>
          </div>

          {/* Sidebar Phải (Lối tắt công cụ tiện ích) */}
          <SidebarRight isDark={isDark} />
        </div>
      );
    }

    // Sidebar Menu Trái: Điều hướng các phân hệ công cụ
    function SidebarLeft({ active, setActive, isDark }) {
      const menuItems = [
        {
          label: 'Kho tiện ích',
          icon: <IconBoxes size={22} />,
        },
        {
          label: 'Quy trình Step-by-Step',
          icon: <IconListOrdered size={22} />,
        },
        {
          label: 'Lịch sử & Tệp xuất',
          icon: <IconHistory size={22} />,
        },
        {
          label: 'Tiện ích Trực quan',
          badge: true,
          icon: <IconZap size={22} />,
        },
      ];

      return (
        <aside
          className={clsx(
            'w-24 h-full flex flex-col items-center py-7 justify-between transition-colors duration-300 relative border-r',
            isDark
              ? 'bg-[#251d42]/60 border-white/10'
              : 'bg-white/40 border-black/5'
          )}
        >
          {/* Logo Brand Icon chuẩn Lucide */}
          <div className="w-12 h-12 rounded-2xl flex items-center justify-center shadow-lg transition-transform hover:scale-105 cursor-pointer bg-gradient-to-tr from-indigo-500 via-purple-500 to-pink-500 text-white font-black text-xl">
            <IconWrench size={22} className="text-white" />
          </div>

          {/* Dải Icons Menu điều hướng */}
          <div
            className={clsx(
              'flex flex-col space-y-3 p-2 rounded-3xl backdrop-blur-md transition-all',
              isDark
                ? 'bg-white/5 border border-white/10 shadow-inner'
                : 'bg-black/5 border border-black/5 shadow-inner'
            )}
          >
            {menuItems.map((item, idx) => {
              const isActive = active === idx;
              return (
                <button
                  key={item.label}
                  onClick={() => setActive(idx)}
                  title={item.label}
                  className={clsx(
                    'w-14 h-14 rounded-2xl flex items-center justify-center transition-all duration-300 relative group cursor-pointer',
                    isActive
                      ? 'bg-gradient-to-b from-indigo-500 to-purple-600 text-white shadow-lg shadow-indigo-600/40 scale-105'
                      : isDark
                      ? 'text-slate-400 hover:text-white hover:bg-white/10'
                      : 'text-slate-500 hover:text-slate-900 hover:bg-black/5'
                  )}
                >
                  <div className="transition-transform group-hover:scale-110 flex items-center justify-center">
                    {item.icon}
                  </div>

                  {/* Active Indicator */}
                  {isActive && (
                    <span className="absolute -left-1 w-1.5 h-6 rounded-r-full bg-white"></span>
                  )}
                </button>
              );
            })}
          </div>

          {/* Nút Cài đặt công cụ */}
          <button
            title="Cài đặt tiện ích & API"
            className={clsx(
              'w-11 h-11 rounded-2xl flex items-center justify-center transition-colors cursor-pointer',
              isDark
                ? 'text-slate-400 hover:text-white hover:bg-white/10'
                : 'text-slate-500 hover:text-slate-800 hover:bg-black/5'
            )}
          >
            <IconSettings size={20} />
          </button>
        </aside>
      );
    }

    // Header với Tìm kiếm tiện ích và Chuyển đổi giao diện Sáng / Tối
    function Header({ theme, toggleTheme, isDark }) {
      const [searchQuery, setSearchQuery] = useState('');

      return (
        <header className="h-20 flex items-center justify-between border-b border-white/5 pr-4 flex-shrink-0">
          {/* Tiêu đề nền tảng Tiện ích */}
          <div className="flex items-center space-x-3">
            <span className="text-xl font-black tracking-tight bg-gradient-to-r from-indigo-400 via-purple-300 to-pink-400 bg-clip-text text-transparent">
              UTILITY HUB
            </span>
            <span
              className={clsx(
                'text-xs font-semibold px-2.5 py-0.5 rounded-full border glass-badge',
                isDark
                  ? 'bg-purple-900/30 text-purple-300 border-purple-500/30'
                  : 'bg-purple-100/80 text-purple-700 border-purple-200'
              )}
            >
              TIỆN ÍCH STEP FLOW
            </span>
          </div>

          {/* Ô Tìm Kiếm Tiện Ích */}
          <div className="relative">
            <input
              type="text"
              value={searchQuery}
              onChange={(e) => setSearchQuery(e.target.value)}
              placeholder="Tìm tiện ích: Nén ảnh, chuyển PDF, OCR, Dev..."
              className={clsx(
                'w-80 pl-10 pr-4 py-2 text-sm rounded-full outline-none transition-all duration-300 backdrop-blur-md border shadow-sm',
                isDark
                  ? 'bg-white/5 border-white/10 text-white placeholder-slate-400 focus:bg-white/10 focus:border-indigo-400'
                  : 'bg-black/5 border-black/10 text-slate-800 placeholder-slate-500 focus:bg-white focus:border-indigo-500'
              )}
            />
            <div className={clsx(
              'absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none flex items-center justify-center',
              isDark ? 'text-slate-400' : 'text-slate-500'
            )}>
              <IconSearch size={16} />
            </div>
          </div>

          {/* Các nút hành động & Theme Toggle */}
          <div className="flex items-center space-x-3">
            <button
              onClick={toggleTheme}
              title={`Chuyển sang giao diện ${isDark ? 'Sáng (Light Glass)' : 'Tối (Dark Glass)'}`}
              className={clsx(
                'flex items-center space-x-2 px-3 py-1.5 rounded-full backdrop-blur-lg border transition-all duration-300 cursor-pointer shadow-md group glass-badge',
                isDark
                  ? 'bg-white/10 border-white/20 text-yellow-300 hover:bg-white/15'
                  : 'bg-white/80 border-purple-200 text-indigo-700 hover:bg-white'
              )}
            >
              {isDark ? (
                <>
                  <IconSun size={15} />
                  <span className="text-xs font-semibold text-white">Giao diện Sáng</span>
                </>
              ) : (
                <>
                  <IconMoon size={15} />
                  <span className="text-xs font-semibold text-slate-800">Giao diện Tối</span>
                </>
              )}
            </button>

            {/* Thông báo cập nhật công cụ */}
            <button
              title="Thông báo tiện ích mới"
              className={clsx(
                'w-9 h-9 rounded-full flex items-center justify-center border transition-colors cursor-pointer',
                isDark
                  ? 'border-white/10 text-slate-300 hover:text-white hover:bg-white/10'
                  : 'border-black/10 text-slate-600 hover:text-slate-900 hover:bg-black/5'
              )}
            >
              <IconBell size={16} />
            </button>

            {/* Trợ lý AI hỗ trợ tiện ích */}
            <button
              title="Trợ lý AI Tiện Ích"
              className={clsx(
                'w-9 h-9 rounded-full flex items-center justify-center border transition-colors cursor-pointer relative',
                isDark
                  ? 'border-white/10 text-slate-300 hover:text-white hover:bg-white/10'
                  : 'border-black/10 text-slate-600 hover:text-slate-900 hover:bg-black/5'
              )}
            >
              <IconSparkles size={16} className={isDark ? 'text-purple-300' : 'text-purple-600'} />
              <span className="w-2 h-2 rounded-full bg-emerald-500 absolute top-1.5 right-1.5"></span>
            </button>
          </div>
        </header>
      );
    }

    // Tiện ích tâm điểm (Hero Tool Section với Card Glass)
    function HeroToolSection({ isDark }) {
      return (
        <div className="relative flex-[1.4] min-w-0">
          <div className="glass-card rounded-3xl p-2.5 transition-all duration-300">
            <div className="relative rounded-2xl overflow-hidden group cursor-pointer">
              <img
                src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=1000&q=80"
                alt="Tiện ích nổi bật"
                onError={(e) => handleImgError(e, 'Tiện Ích Nổi Bật')}
                className="w-full h-[230px] object-cover transition-transform duration-500 group-hover:scale-105"
              />

              {/* Huy hiệu Step-by-Step kính mờ góc trên */}
              <div className="absolute top-3 left-3 flex items-center space-x-2">
                <span className="glass-badge bg-indigo-600/85 text-white text-[11px] font-extrabold uppercase px-2.5 py-1 rounded-full flex items-center space-x-1.5 shadow-lg">
                  <span className="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                  <span>STEP-BY-STEP FLOW</span>
                </span>
                <span className="glass-badge bg-black/50 text-slate-200 text-[11px] font-semibold px-2.5 py-0.5 rounded-full flex items-center space-x-1">
                  <IconZap size={13} className="text-amber-300" />
                  <span>3 BƯỚC HOÀN THÀNH</span>
                </span>
              </div>

              {/* Thông tin tiện ích dạng kính gradient */}
              <div className="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent flex flex-col justify-end p-4">
                <span className="text-white text-lg font-bold line-clamp-1 group-hover:text-indigo-300 transition-colors">
                  Bộ Xử Lý Đa Năng: Nén, Đổi Đuôi & Tối Ưu Tệp Tự Động
                </span>
                <div className="flex items-center space-x-3 text-slate-300 text-xs mt-1">
                  <span className="flex items-center space-x-1">
                    <span className="w-2 h-2 rounded-full bg-emerald-400 inline-block mr-1"></span>
                    <span>Đang sẵn sàng hoạt động</span>
                  </span>
                  <span>•</span>
                  <span>Kéo thả tệp hoặc chọn quy trình mẫu</span>
                </div>
              </div>
            </div>
          </div>

          {/* Mini Widget PiP: Quick Dropzone & Kiểm tra tệp */}
          <div className="absolute -left-3 -bottom-5 z-20">
            <div className="relative">
              <div className="ping-outer" />
              <div
                className={clsx(
                  'glass-card rounded-2xl p-2 shadow-2xl flex items-center space-x-3 w-44',
                  isDark ? 'bg-[#1e1737]/95' : 'bg-white/95'
                )}
              >
                <div className="w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white shadow-md flex-shrink-0">
                  <IconFolderUp size={20} className="text-white" />
                </div>
                <div className="min-w-0 flex-1">
                  <div className={clsx('text-xs font-bold truncate', isDark ? 'text-white' : 'text-slate-900')}>
                    Thả tệp xử lý
                  </div>
                  <div className="text-[10px] text-emerald-400 font-semibold truncate">
                    Bắt đầu Bước 1/3
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      );
    }

    // Danh sách Quy trình tiện ích Step-by-Step
    function NewsSection({ isDark }) {
      return (
        <div className="flex flex-col space-y-3.5 flex-1 min-w-[320px]">
          {newsList.map(({ key, title, subTitle, image, usage, stepCount, category, tags }) => (
            <div
              key={key}
              className="glass-card rounded-3xl p-3.5 cursor-pointer group"
            >
              <div className="flex space-x-3.5 items-center">
                <div className="relative flex-shrink-0 overflow-hidden rounded-2xl">
                  <img
                    src={image}
                    alt={title}
                    onError={(e) => handleImgError(e, title)}
                    className="w-24 h-20 object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                  {/* Badge số bước quy trình */}
                  <div className="absolute bottom-1 right-1 glass-badge bg-black/70 text-amber-300 text-[9px] font-bold px-1.5 py-0.5 rounded-md">
                    {stepCount}
                  </div>
                </div>

                <div className="flex-1 min-w-0">
                  <div className="flex items-center justify-between mb-0.5">
                    <span className="text-[10px] font-extrabold uppercase tracking-wider text-indigo-400">
                      {category}
                    </span>
                    <span className="text-[10px] text-slate-400">
                      {usage}
                    </span>
                  </div>
                  <div
                    className={clsx(
                      'text-sm font-semibold truncate group-hover:text-indigo-400 transition-colors',
                      isDark ? 'text-white' : 'text-slate-900'
                    )}
                  >
                    {title}
                  </div>
                  <div
                    className={clsx(
                      'text-xs truncate mt-0.5',
                      isDark ? 'text-slate-400' : 'text-slate-500'
                    )}
                  >
                    {subTitle}
                  </div>
                  <div className="flex space-x-1.5 mt-2.5">
                    {tags.map(({ text, color }) => (
                      <span
                        key={text}
                        className="glass-badge text-[10px] font-bold uppercase tracking-wider text-white px-2 py-0.5 rounded-full"
                        style={{ backgroundColor: color }}
                      >
                        {text}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      );
    }

    // Khu vực Kho Tiện Ích Đề Xuất (Lựa chọn hàng đầu)
    function TopSelection({ isDark }) {
      const [selectedCat, setSelectedCat] = useState(0);

      return (
        <div className="mt-4 pt-2">
          {/* Header Kho Tiện Ích */}
          <div className="flex items-center justify-between mb-4">
            <h2
              className={clsx(
                'text-2xl font-black tracking-tight',
                isDark ? 'text-white' : 'text-slate-900'
              )}
            >
              Kho Tiện Ích Step-by-Step
            </h2>
            <div className="glass-badge flex items-center space-x-2 bg-emerald-600/90 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider shadow-md shadow-emerald-600/20">
              <span className="w-2 h-2 rounded-full bg-white animate-pulse"></span>
              <span>SẴN SÀNG SỬ DỤNG</span>
            </div>
          </div>

          <div className="flex items-start gap-8">
            {/* Phân loại tiện ích */}
            <div className="w-56 flex flex-col space-y-2 flex-shrink-0">
              {topSelectionCategories.map((category, idx) => {
                const isActive = selectedCat === idx;
                return (
                  <button
                    key={category}
                    onClick={() => setSelectedCat(idx)}
                    className={clsx(
                      'flex items-center space-x-3 px-3.5 py-2.5 rounded-2xl text-xs font-bold uppercase tracking-wider transition-all duration-200 text-left cursor-pointer border glass-badge',
                      isActive
                        ? isDark
                          ? 'bg-indigo-500/25 text-indigo-300 border-indigo-500/40 shadow-sm'
                          : 'bg-indigo-100 text-indigo-700 border-indigo-300 shadow-sm'
                        : isDark
                        ? 'text-slate-400 border-transparent hover:text-white hover:bg-white/5'
                        : 'text-slate-500 border-transparent hover:text-slate-900 hover:bg-black/5'
                    )}
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 20 20"
                      className="w-4 h-4 flex-shrink-0"
                      fill="currentColor"
                    >
                      {topSelectIcons[idx]}
                    </svg>
                    <span className="truncate">{category}</span>
                  </button>
                );
              })}
            </div>

            {/* Danh sách Thẻ Tiện ích Glassmorphism */}
            <div className="grid grid-cols-3 gap-4 flex-1">
              {topSelectionItemList.map((item) => (
                <div
                  key={item.key}
                  className="glass-card rounded-3xl p-3 cursor-pointer group"
                >
                  <div className="overflow-hidden rounded-2xl relative mb-3">
                    <img
                      src={item.image}
                      alt={item.title}
                      onError={(e) => handleImgError(e, item.title)}
                      className="w-full h-28 object-cover transition-transform duration-500 group-hover:scale-105"
                    />

                    {/* Huy hiệu số lượt dùng */}
                    <div className="absolute top-2 right-2 glass-badge bg-black/60 text-white text-[10px] font-bold px-2 py-0.5 rounded-full flex items-center space-x-1">
                      <span>⚡</span>
                      <span>{item.usage}</span>
                    </div>

                    {/* Huy hiệu quy trình step */}
                    <div className="absolute bottom-2 left-2 glass-badge bg-indigo-950/80 text-indigo-200 text-[9px] font-semibold px-2 py-0.5 rounded-md">
                      {item.stepBadge}
                    </div>

                    {/* Nút Khởi chạy tiện ích khi hover */}
                    <div className="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                      <div className="px-3.5 py-1.5 rounded-full glass-badge bg-white/30 text-white flex items-center space-x-1.5 text-xs font-bold shadow-xl hover:scale-105 transition-transform">
                        <span>Bắt đầu</span>
                        <IconArrowRight size={13} />
                      </div>
                    </div>
                  </div>

                  <div className="flex items-center space-x-2.5">
                    <img
                      src={item.avatar}
                      alt={item.author}
                      onError={(e) => handleImgError(e, 'Tác giả')}
                      className="w-9 h-9 rounded-full object-cover ring-2 ring-indigo-500/40 flex-shrink-0"
                    />
                    <div className="min-w-0 flex-1">
                      <div
                        className={clsx(
                          'text-xs font-bold truncate group-hover:text-indigo-400 transition-colors',
                          isDark ? 'text-white' : 'text-slate-900'
                        )}
                      >
                        {item.title}
                      </div>
                      <div
                        className={clsx(
                          'text-[11px] truncate',
                          isDark ? 'text-slate-400' : 'text-slate-500'
                        )}
                      >
                        {item.subTitle}
                      </div>
                      <div className="flex space-x-1 mt-1.5">
                        {item.tags.map(({ text, color }) => (
                          <span
                            key={text}
                            className="glass-badge text-[9px] font-bold text-white px-1.5 py-0.5 rounded-full uppercase"
                            style={{ backgroundColor: color }}
                          >
                            {text}
                          </span>
                        ))}
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      );
    }

    // Sidebar Phải (Lối tắt khởi động nhanh các công cụ)
    function SidebarRight({ isDark }) {
      return (
        <aside
          className={clsx(
            'w-20 h-full flex flex-col items-center py-7 justify-between border-l transition-colors duration-300',
            isDark
              ? 'bg-[#1a1433]/70 border-white/10'
              : 'bg-white/40 border-black/5'
          )}
        >
          {/* User Profile / Status Indicator */}
          <div className="w-14 h-14 rounded-full p-1 relative cursor-pointer group">
            <div className="avatar-ring inset-0 absolute transition-transform duration-700 group-hover:rotate-180" />
            <div className="absolute inset-0 p-1">
              <img
                src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&q=80"
                alt="Hồ sơ người dùng"
                onError={(e) => handleImgError(e, 'User')}
                className="w-full h-full rounded-full object-cover shadow-md"
              />
            </div>
          </div>

          {/* Lối tắt công cụ tiện ích (Quick Tools Tray) */}
          <div className="flex flex-col space-y-3.5">
            {sidebarRightIcons.map(({ name, background, icon, desc }) => (
              <button
                key={name}
                title={`${name} - ${desc}`}
                className="w-10 h-10 rounded-2xl flex items-center justify-center shadow-lg transition-transform hover:scale-110 active:scale-95 cursor-pointer text-base"
                style={{ backgroundColor: background }}
              >
                {icon}
              </button>
            ))}
          </div>

          {/* Trạng thái bộ xử lý nền (Task Queues) */}
          <div className="flex flex-col space-y-3">
            <div
              title="Tiến trình nén tệp: Đã xong"
              className="w-10 h-10 rounded-2xl glass-card flex items-center justify-center relative cursor-pointer hover:ring-2 hover:ring-indigo-400 transition-all text-xs"
            >
              <IconCheckCircle2 size={18} className="text-emerald-400" />
