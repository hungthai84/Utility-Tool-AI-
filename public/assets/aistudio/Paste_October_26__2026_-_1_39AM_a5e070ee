    /* Subtle pulsing live indicator */
    .ping-outer {
      position: absolute;
      right: 15px;
      top: 15px;
      width: 10px;
      height: 10px;
      border-radius: 999px;
      background-color: #ea4d5f;
      z-index: 40;
      animation: ping-online 1.4s cubic-bezier(0, 0, 0.2, 1) infinite;
